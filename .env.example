# Razorpay (Test Mode) — Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Neo4j AuraDB (free tier) — from the instance's connection details
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Kaggle (only needed if pulling the dataset via API)
KAGGLE_USERNAME=
KAGGLE_KEY=
